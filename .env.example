# Proxy DataImpulse — el usuario va SIN parámetros (__cr, sessid...): la app los añade sola
PROXY_HOST=gw.dataimpulse.com
PROXY_PORT=823
PROXY_USERNAME=tu_usuario_aqui
PROXY_PASSWORD=tu_password_aqui

# Minutos que DataImpulse mantiene la misma IP en cada perfil (sesión fija)
PROXY_SESSION_TTL_MIN=60

# Saldo inicial del plan en GB (luego se sincroniza desde la pestaña Consumo)
PROXY_LIMIT_GB=5

# Opcionales
# PORT=3000
# START_URL=https://browserleaks.com/ip
